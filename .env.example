# ── Supabase ──
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Used by scripts/migrate-to-supabase.ts,
# scripts/seed-demo-users.ts, and any server action that needs elevated access.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstash Redis (optional — caching, rate limiting, visitor counters) ──
# Everything that reads these falls back gracefully (direct DB read / no rate
# limit / no counter) when they're unset, so the app works without Redis.
# Upstash dashboard → your database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI Assistant — pick one (Groq is tried first if both are set) ──
# Without either key, the assistant uses the built-in knowledge base (plant catalogue data).

# Groq (https://console.groq.com/keys) — OpenAI-compatible API, fast + generous free tier.
# Check https://console.groq.com/docs/models for the current model list — it
# changes over time; `openai/gpt-oss-20b` was current when this was written.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# OpenAI — used only if GROQ_API_KEY is unset.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
